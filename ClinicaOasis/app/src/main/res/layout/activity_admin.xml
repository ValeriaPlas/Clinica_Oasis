<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera de administración -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background_dos"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/textAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administración"
                android:textColor="#000"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Menú oculto de administración -->
        <LinearLayout
            android:id="@+id/menuOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical"
            android:background="@drawable/card_background_dos"
            android:padding="12dp"
            android:elevation="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:layout_alignParentEnd="true">

            <Button
                android:id="@+id/btnAbout"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="ℹ️ Acerca de"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/colorAccent"
                android:layout_marginBottom="8dp"
                android:background="@drawable/card_background_tres" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="🚪 Cerrar sesión"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@android:color/holo_red_dark"
                android:background="@drawable/card_background_tres" />
        </LinearLayout>

        <!-- Botones de gestión (si los quieres seguir mostrando) -->
        <Button
            android:id="@+id/btnManageDoctors"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👨‍⚕️ Gestionar Doctores"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/colorPrimary"
            android:elevation="6dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_background_tres"/>

        <Button
            android:id="@+id/btnManageNotices"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📢 Gestionar Avisos"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/colorAccent"
            android:elevation="6dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_background_tres"/>


        <Button
            android:id="@+id/btnCrudUsuarios"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👥 Usuarios Y Roles"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:elevation="6dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_background_tres"/>

        <Button
            android:id="@+id/btnViewAppointments"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📅 Ver Citas"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:elevation="6dp"
            android:background="@drawable/card_background_tres"/>

    </LinearLayout>
</ScrollView>
