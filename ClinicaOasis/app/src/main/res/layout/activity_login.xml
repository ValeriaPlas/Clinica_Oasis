<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EFF4"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Imagen de perfil -->
        <ImageView
            android:id="@+id/imageViewPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/perfil_default"
            android:background="@drawable/card_background"
            android:padding="8dp"
            android:elevation="6dp"
            android:layout_marginBottom="28dp"
            android:contentDescription="Imagen de perfil" />

        <!-- Sección Usuario -->
        <LinearLayout
            android:id="@+id/layoutUsuario"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:elevation="3dp"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/editTextUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Usuario"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:textColor="#212121"
                android:textColorHint="#757575"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp"
                android:elevation="2dp" />

            <Button
                android:id="@+id/btnAceptarUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aceptar"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnRegistrarse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrarse"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Sección Contraseña/Login -->
        <LinearLayout
            android:id="@+id/layoutLogin"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:elevation="3dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/editTextPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contraseña"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:textColor="#212121"
                android:textColorHint="#757575"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp"
                android:elevation="2dp" />

            <CheckBox
                android:id="@+id/checkBoxShowPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mostrar contraseña"
                android:textColor="#424242"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnDeleteProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eliminar perfil"
                android:backgroundTint="#E53935"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
